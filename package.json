    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "tree-sitter-wasms": "0.1.13",
    "@playwright/test": "^1.64.1"
